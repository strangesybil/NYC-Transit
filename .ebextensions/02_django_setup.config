# The site runs as the "webapp" user, but these commands run as root. The database
# therefore lives in /var/app/data (owned by webapp, kept between deploys) instead of
# the app folder, which root owns and Elastic Beanstalk replaces on every deploy.
option_settings:
  aws:elasticbeanstalk:application:environment:
    SQLITE_PATH: /var/app/data/db.sqlite3

container_commands:
  00_data_dir:
    command: "mkdir -p /var/app/data"
  01_migrate:
    command: "source $PYTHONPATH/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source $PYTHONPATH/activate && python manage.py collectstatic --noinput"
  03_data_dir_owner:
    # migrate ran as root, so hand the folder and database file to the site's user
    command: "chown -R webapp:webapp /var/app/data"
